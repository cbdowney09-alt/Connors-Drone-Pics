rules_version = '2';

// KnoxCanvas Firestore rules. Publish in the Firebase console (Firestore Database → Rules)
// or with `firebase deploy --only firestore:rules`.
//
// - Every company belongs to one owner; employees join with a one-time invite code.
// - New companies start `status: 'pending'` and only a KnoxCanvas admin (a doc in
//   `admins/{uid}`, added by hand in the console) can approve, pause or resume them.
//   Companies with no status (made before approvals) count as active.
// - Members of a company that isn't active can still read the company doc (to see
//   "waiting for approval" / "paused") but not its pins, shifts or settings.
// - Doorline Hangers: businesses that sign up through it get `doorline: true`. The admin lists
//   which people hang for each one in its `crew` array (uids); the crew can then read and write
//   that company's pins, shifts and settings, the same as its own members. Only an admin can
//   change `crew` or `doorline`.
// - Doorline crew members can also belong to no company at all: they join with a crew invite
//   (`invites/{code}.crew == true`, made only by an admin) and get `role: 'crew'`, `companyId: ''`.
// - Company admins: the owner can promote employees (`companies/{id}.managers`, uids). They run the team
//   like the owner (metrics, every hot lead, invites, removing employees, neighborhoods, deleting pins) but
//   can't change the company doc (settings, who's an admin) or remove another admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }

    function myProfile() { return get(/databases/$(database)/documents/users/$(me())).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(me())); }
    function inCompany(cid) { return cid != '' && hasProfile() && myProfile().get('companyId', '') == cid; }

    function companyDoc(cid) { return get(/databases/$(database)/documents/companies/$(cid)).data; }
    function isActive(cid) { return companyDoc(cid).get('status', 'active') == 'active'; }
    function ownsCompany(cid) { return signedIn() && companyDoc(cid).ownerId == me(); }
    function onCrew(cid) { return signedIn() && me() in companyDoc(cid).get('crew', []); }
    // A company admin: an employee the owner promoted. Leaving the company ends it (inCompany).
    function isManager(cid) { return inCompany(cid) && me() in companyDoc(cid).get('managers', []); }
    function isDoorline(cid) { return companyDoc(cid).get('doorline', false) == true; }
    // Can see the company's map, shifts and settings.
    function canRead(cid) { return isAdmin() || ((inCompany(cid) || onCrew(cid)) && isActive(cid)); }
    // Can mark doors and save shifts. A Doorline client only looks: their crew does the work
    // (and the client is billed by the door, so they must not be able to change the count).
    function canWork(cid) { return isAdmin() || (isActive(cid) && (onCrew(cid) || (inCompany(cid) && !isDoorline(cid)))); }
    function isBoss(cid) { return isAdmin() || ((ownsCompany(cid) || isManager(cid)) && isActive(cid)); }
    // Can remove pins and shifts: you, or the owner or an admin of a regular (non-Doorline) company.
    function canRemove(cid) { return isAdmin() || ((ownsCompany(cid) || isManager(cid)) && isActive(cid) && !isDoorline(cid)); }

    // ── Admins: only readable by themselves; created by hand in the console ──
    match /admins/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list, write: if false;
    }

    // ── Users ──
    match /users/{uid} {
      // Yourself, anyone in your company (team list, names on the map), or an admin.
      allow get: if signedIn() && (me() == uid || inCompany(resource.data.get('companyId', '')) || isAdmin());
      allow list: if isAdmin() || (hasProfile() && myProfile().get('companyId', '') != ''
        && resource.data.get('companyId', '') == myProfile().get('companyId', '-'));

      // Owner: in the same batch as a new pending company they own.
      // Employee: with a valid, unexpired invite for that company, deleted in the same batch.
      // Doorline crew: with a valid crew invite (no company), deleted in the same batch.
      allow create: if signedIn() && me() == uid && (
        (request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerId == uid
          && !exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)))
        ||
        (request.resource.data.role == 'employee'
          && request.resource.data.inviteCode is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.companyId == request.resource.data.companyId
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time
          && !existsAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)))
        ||
        (request.resource.data.role == 'crew'
          && request.resource.data.get('companyId', '') == ''
          && request.resource.data.inviteCode is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.get('crew', false) == true
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time
          && !existsAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)))
      );

      // Your own doc (name, activeClockIn), but never your role or company.
      allow update: if isAdmin() || (signedIn() && me() == uid
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('companyId', '') == resource.data.get('companyId', ''));

      // Yourself (delete account / start over), the owner (or a company admin) removing an employee,
      // or an admin. A company admin can't remove another company admin.
      allow delete: if isAdmin() || (signedIn() && (me() == uid
        || (resource.data.get('role', '') == 'employee' && ownsCompany(resource.data.get('companyId', '')))
        || (resource.data.get('role', '') == 'employee' && isManager(resource.data.get('companyId', ''))
          && !(uid in companyDoc(resource.data.get('companyId', '')).get('managers', [])))));
    }

    // ── Companies ──
    match /companies/{cid} {
      allow get: if isAdmin() || inCompany(cid) || (signedIn() && resource.data.ownerId == me())
        || (signedIn() && me() in resource.data.get('crew', []));
      // Admin: everything. Crew: the Doorline clients they hang for (query: crew array-contains uid).
      allow list: if isAdmin() || (signedIn() && me() in resource.data.get('crew', []));

      // Only as a pending request, owned by the person creating it, who has no company yet.
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.status == 'pending'
        && !exists(/databases/$(database)/documents/users/$(me()))
        && getAfter(/databases/$(database)/documents/users/$(me())).data.companyId == cid;

      // Admin: anything (approve, pause, resume, decline, crew). Owner: settings, states and company admins
      // (`managers`), never status.
      allow update: if isAdmin() || (signedIn() && resource.data.ownerId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'sheetsUrl', 'roofCutoff', 'states', 'doorRadius', 'managers']));

      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == me());

      // ── Pins: anyone working the company marks doors. Only the owner, you, or whoever
      // placed a pin can remove it, so nobody can wipe the map or the billed hanger count.
      // A Doorline client's owner can't remove pins at all: they're billed by the door.
      match /pins/{pid} {
        allow read: if canRead(cid);
        allow create, update: if canWork(cid);
        allow delete: if canRemove(cid) || (canWork(cid) && resource.data.get('createdBy', '') == me());
      }

      // ── Shifts: each person saves only their own, with real numbers (shift lists show them).
      match /shifts/{sid} {
        allow read: if canRead(cid);
        allow create: if canWork(cid) && request.resource.data.userId == me() && shiftNumbers();
        allow update: if canWork(cid) && resource.data.userId == me() && request.resource.data.userId == me() && shiftNumbers();
        allow delete: if canRemove(cid);
      }

      // ── Hot leads (photo kept in leadPhotos/{same id}): canvassers send them, the owner reads
      // and updates them. A canvasser sees only their own.
      match /leads/{lid} {
        allow read: if isBoss(cid) || (canRead(cid) && resource.data.get('by', '') == me());
        allow create: if canWork(cid) && request.resource.data.by == me();
        allow update: if isBoss(cid);
        allow delete: if isBoss(cid);
      }
      match /leadPhotos/{lid} {
        allow read: if isBoss(cid) || (canRead(cid) && resource.data.get('by', '') == me());
        allow create: if canWork(cid) && request.resource.data.by == me();
        allow delete: if isBoss(cid);
      }

      // ── House photos: anyone working the company adds them (shrunk to ~200 KB in the browser);
      // whoever took one, the owner of a regular company, or you can delete it.
      match /pinPhotos/{phid} {
        allow read: if canRead(cid);
        allow create: if canWork(cid) && request.resource.data.by == me()
          && request.resource.data.pinId is string && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
        allow delete: if canRemove(cid) || (canWork(cid) && resource.data.get('by', '') == me());
      }

      // ── Settings: the owner's (neighborhood assignments and routes in `areas`). Year-built
      // zones (`neighborhoodYears`) can still be saved by anyone working the company.
      match /settings/{sid} {
        allow read: if canRead(cid);
        allow write: if isBoss(cid) || (sid == 'neighborhoodYears' && canWork(cid));
      }

      // ── Anything else under a company: read like the map, written only by the owner or you.
      // (Rules add up, so the collections above are left out here; otherwise this would let
      // every canvasser read every hot lead.)
      match /{coll}/{rest=**} {
        allow read: if canRead(cid) && !(coll in ['leads', 'leadPhotos']);
        allow write: if isBoss(cid) && !(coll in ['pins', 'shifts', 'leads', 'leadPhotos', 'pinPhotos', 'settings']);
      }
    }

    function shiftNumbers() {
      let d = request.resource.data;
      return d.get('hangers', 0) is number && d.get('hangersPerHour', 0) is number
        && d.get('durationMs', 0) is number && d.get('clockIn', 0) is number;
    }

    // ── Invites: one-time join codes ──
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == me() && (
        (request.resource.data.get('crew', false) != true
          && request.resource.data.companyId is string
          && (ownsCompany(request.resource.data.companyId) || isManager(request.resource.data.companyId))
          && isActive(request.resource.data.companyId))
        ||
        // Doorline crew invite: admins only.
        (request.resource.data.get('crew', false) == true && isAdmin()));
      // The person joining deletes it (single use); the owner can too.
      allow delete: if signedIn();
      allow update: if false;
    }
  }
}
